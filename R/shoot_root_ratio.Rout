> ## Check Assumptions
> 
> E <- residuals(mod_sr, type = "normalized")
> 
> origpar <- par(no.readonly = TRUE)
> par(mfrow = c(1, 2))
> plot(E ~ fitted(mod_sr))
> qqnorm(E)
> qqline(E)
> par(origpar)
> 
> par(mfrow = c(2, 2))
> boxplot(E ~ dat_2023$endo)
> boxplot(E ~ dat_2023$root_damage)
> boxplot(E ~ dat_2023$foliar_damage)
> boxplot(E ~ dat_2023$herb)
> par(origpar)
> 
