> mod_sr <- lme(shoot_root_ratio ~ endo * foliar_damage * root_damage * herb,
+               random = ~ 1 | bloque,
+               weights = varIdent(form = ~ 1 | endo),
+               method = "REML",
+               data = dat_2023)
> 
