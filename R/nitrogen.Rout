> #
> # Total N in roots
> #
> 
> source("R/config.R")
> 
> library(lattice)
> library(nlme)
> library(emmeans)
Welcome to emmeans.
Caution: You lose important information if you filter this package's results.
See '? untidy'
> library(multcomp)
Loading required package: mvtnorm
Loading required package: survival
Loading required package: TH.data
Loading required package: MASS

Attaching package: ‘TH.data’

The following object is masked from ‘package:MASS’:

    geyser

> 
> dat <- read.csv("data/exp_nut.csv")
> 
> dat[["endophyte"]]   <- as.factor(dat[["endophyte"]])
> dat[["root_herb"]]   <- as.factor(dat[["root_herb"]])
> dat[["foliar_herb"]] <- as.factor(dat[["foliar_herb"]])
> dat[["bloque"]]      <- as.factor(dat[["bloque"]])
> 
> ## --------------------------------------------------
> 
> hist(dat$root_Nt_perc)
> 
> 
> options(contrasts = c("contr.sum", "contr.poly"))
> 
> res <- lme(root_Nt_perc ~ endophyte * root_herb * foliar_herb,
+                random = ~ 1 | bloque,
+                method = "REML",
+                data = dat)
> 
> 
> E <- residuals(res, type = "normalized")
> 
> par(mfrow = c(1, 2))
> # subplot 1
> plot(
+     E ~ fitted(res),
+     xlab = "Fitted values",
+     ylab = "Normalized residuals"
+ )
> # subplot 2
> qqnorm(E)
> qqline(E)
> 
> 
> par(mfrow = c(2, 2))
> boxplot(E ~ dat$endophyte)
> boxplot(E ~ dat$root_herb)
> boxplot(E ~ dat$foliar_herb)
> boxplot(E ~ dat$foliar_herb)
> par(mfrow = c(1, 1))
> 
> car::Anova(res, type = "III")
