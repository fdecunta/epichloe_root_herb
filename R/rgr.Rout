> ## ------------------------------------------------------------------
> ## Plots
> 
> y_lim <- c(-16, 15)
> 
> plot_endo_x_foliar_damage <- function() {
+     origpar <- par(no.readonly = TRUE)
+     
+     par(
+         mar = c(4, 6, 1, 1),
+         mgp = c(2.2, 0.75, 0),
+         cex.lab = labs_cex,
+         cex.axis = labs_cex * 0.85
+     )
+ 
+     df <- as.data.frame(emmeans(mod_weight, ~ endo * foliar_damage, sort = FALSE))
+ 
+     stripchart(
+         rgr ~ endo * foliar_damage,
+         data = df_herb,
+         method = "jitter",
+         jitter = 0.17,
+         vertical = TRUE,
+         pch = 19,
+         ylab = "",
+         xlab = labels$foliar_damage,
+         col = adjustcolor(colors$endo, alpha.f = 0.15),
+         ylim = y_lim,
+         axes = FALSE,
+         cex = rawpts_cex
+     )
+ 
+     ## Y axis
+     axis(2, lwd = 0, lwd.ticks = axis_width, las = 1)
+ 
+     title(
+       ylab = labels$weight_change,
+       line = 2.5,
+       cex = labs_cex
+     )
+ 
+     ## Box
+     box(bty = box_type, lwd = axis_width)
+ 
+     ## Vertical line dividing endophyte levels
+     abline(v = 2.5, lty = "dashed", lwd = axis_width)
+ 
+     ## Errorbars
+     arrows(
+         x0 = 1:nrow(df),
+         y0 = df$emmean - df$SE,
+         x1 = 1:nrow(df),
+         y1 = df$emmean + df$SE,
+         length = 0.05,
+         angle = 90,
+         code = 3,
+         lwd = 1.5
+     )
+ 
+     ## Mean Estimates
+     points(
+         x = 1:nrow(df),
+         y = df$emmean,
+         pch = 21,
+         bg = colors$endo,
+         col = "black",
+         cex = estimate_cex
+     )
+ 
+     ## Legend
+     legend(
+         "topright",
+         legend = c("E-", "E+"),
+         pt.bg = colors$endo,
+         pch = 21,
+         cex = labs_cex,
+         pt.cex = xlabs_cex * 1.2,
+         bty = "n"
+     )
+ 
+     ## Letters (positioned above errorbars)
+     text(
+         x = c(1.5, 3.5),
+         y = c(5, 5),
+         labels = c("p = 0.312", "p = 0.007"),
+         cex = xlabs_cex * 0.925,
+         font = c(1, 3)
+     )
+ 
+     ## No/Yes labels at bottom
+     text(
+         x = c(1.5, 3.5),
+         y = -20,
+         labels = c("D-", "D+"),
+         cex = xlabs_cex,
+         xpd = TRUE
+     )
+ 
+     par(origpar)
+ }
> 
